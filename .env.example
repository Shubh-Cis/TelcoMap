# ==============================================================================
# Telecom Network Operations & Intelligence Platform (NOC)
# Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=production

# Backend Service
BACKEND_PORT=3001
CORS_ORIGIN=*

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=telcomap
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Prisma Connection URL (Used by NestJS inside Docker network)
DATABASE_URL=postgresql://postgres:postgres_secure_pass@postgres:5432/telcomap?schema=public

# Frontend / Nginx Gateway Port (Mapped to host)
FRONTEND_PORT=3000

# Host PostgreSQL Port (Mapped to host if direct inspection needed)
DB_HOST_PORT=5433

# Cloudflare Radar API (Zambia & Regional Network Telemetry)
CLOUDFLARE_RADAR_TOKEN=cfut_your_cloudflare_radar_token_here

# AI Network Intelligence
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
